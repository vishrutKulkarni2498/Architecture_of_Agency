# --- 1. API KEYS (Mandatory) ---
# Your core model provider, e.g., 'anthropic' or 'openai'
LLM_PROVIDER=anthropic

# REQUIRED for the selected provider
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here


# --- 2. MODEL CONFIGURATION (Optional) ---
# Default models for each provider (can be overridden per node)
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
OPENAI_MODEL=gpt-4o

# Optional: LangSmith for tracing and debugging (highly recommended)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_key_here
# LANGCHAIN_PROJECT=Sentinel_A11

# --- 3. SYSTEM SETTINGS ---
# Set the logging level (INFO, DEBUG, ERROR)
LOG_LEVEL=INFO
# Path for storing generated diagrams (sentinel_*.png)
# If empty, will use the root of the notebooks directory
DIAGRAM_OUTPUT_PATH=